# Base URL of the PlaySpec API (see ../PlaySpec's BASE_PATH / PORT).
VITE_API_BASE_URL=http://localhost:4000/play-spec/api

# Must match BASIC_AUTH_USER/PASS in ../PlaySpec's .env — required by
# /validate, /feedback, and /queue (see src/lib/api.ts's basicAuthHeaders).
# Note this ships inside the built JS bundle like any other VITE_* value —
# readable by anyone who opens devtools, not a real secret from the app's
# own users, only from people who never loaded the site at all.
VITE_BASIC_AUTH_USER=
VITE_BASIC_AUTH_PASS=
